# CMediSewa environment variables: NAMES ONLY. Copy to .env.local (dev) and fill in.
# Real values live in .env.local (gitignored) and in Coolify secrets for staging/prod.

# Which environment this file belongs to: development | staging | production.
# The migration runner refuses to write to production unless --prod --yes is given
# AND this says production.
APP_ENV="development"

# Browser-safe. The publishable key holds NO table grants (migration 0001).
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Server-only. Secret key (service_role). Never import from client code.
SUPABASE_SECRET_KEY=""

# Server-only. Postgres connection (migrations, DB tests, realtime LISTEN).
# Keep it QUOTED, and URL-encode special characters in the password (@ → %40).
SUPABASE_DB_URL=""

# Server-only. HMAC key for trusted-device tokens and login-attempt hashes (B1).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Rotating it un-trusts every device and resets password lockout counters.
AUTH_HMAC_SECRET=""

# Server-only. Shared secret for /api/cron/* (subscription expiry, B2). Sent as the x-cron-secret header.
CRON_SECRET=""

# Public base URL used to build invite links (e.g. https://cmedisewa.example).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Added in later milestones (see memory-bank/deployment.md §5):
# RESEND_API_KEY, MAIL_FROM, NEXT_PUBLIC_VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY,
# VAPID_SUBJECT, MANAGE_TOKEN_PEPPER, PATIENT_SESSION_PEPPER,
# TURNSTILE_SITE_KEY, TURNSTILE_SECRET_KEY
